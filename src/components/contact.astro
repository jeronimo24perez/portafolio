<section class="contact" id="contact">
    <form class="glass">
        <h2>Contactame</h2>
        <div class="input-group">
            <input type="email" id="email" placeholder="" required />
            <label>Email</label>

        </div>
        <div class="input-group">
            <input type="tel" id="cel" placeholder="" required />
            <label>Telefono</label>

        </div>
        <div class="input-group">
            <textarea placeholder="" id="msg" required />
            <label>Mensaje</label>

        </div>
        <button class="button contact-button">Enviar</button>
        <p>Tambien puedes contactarme por WhatsApp clickeando el icono de la derecha de tu pantalla</p>
    </form>
</section>