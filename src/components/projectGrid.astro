---
import type {Project} from '../models/project.ts';
import {Image} from 'astro:assets'
import x from '../assets/clon-de-x.png'
import starwars from '../assets/starwars.png'
import gorrasApp from '../assets/gorras-app.png'
import crud from '../assets/crudImage.png'
import backendX from '../assets/backendX.png'
import backendCrud from '../assets/backendCrud.png'
import backendGorras from '../assets/api_django.png'

const projects: Project[] = [
    {
        id: 1,
        name: "Clon de X",
        tech: ["devicon-css3-plain colored","devicon-react-original colored  ", "devicon-typescript-plain colored", "devicon-redux-original colored ", "devicon-python-plain-wordmark  ", "devicon-fastapi-plain colored ", "devicon-mongodb-plain colored "],
        description: "En este proyecto desarrollé desde cero un clon de X (Twitter) con funcionalidades como registro e inicio de sesión de usuarios, autenticación, sistema de seguidores, publicaciones, likes y otras características propias de una red social.\n" +
            "Para su desarrollo utilicé CSS, React con TypeScript, Redux Toolkit en el frontend, y Python con FastAPI junto con MongoDB en el backend.",
        link: "https://x-app-olive.vercel.app/",
        code: "https://github.com/jeronimo24perez/x-app",
        image: x
    },
    {
        id: 2,
        name: "Blog de Star Wars",
        tech: ["devicon-react-original colored  ", "devicon-css3-plain colored", "devicon-javascript-plain colored"],
        description: "En este proyecto desarrollé un blog inspirado en Star Wars, donde presento juegos, personajes y algunas historias de la saga, acompañado de una interfaz cuidada y atractiva.\n" +
            "\n" +
            "Para su desarrollo utilicé React con JavaScript y CSS, enfocándome en lograr un diseño visual limpio, dinámico y bien estructurado.",
        link: "https://star-wars-two-sigma.vercel.app/",
        code: "https://github.com/jeronimo24perez/starWars",
        image: starwars
    },
    {
        id: 3,
        name: "Aplicacion To Do",
        tech: ["devicon-react-original colored  ", "devicon-css3-plain colored", "devicon-javascript-plain colored", "devicon-materializecss-plain colored", "devicon-nodejs-plain colored ", "devicon-express-original", "devicon-mongodb-plain colored"],
        description: "En este proyecto desarrollé una aplicación de tareas basada en un sistema CRUD (Create, Read, Update, Delete), que permite crear, visualizar, editar y eliminar tareas de forma sencilla e intuitiva.\n" +
            "Para su desarrollo utilicé React, JavaScript, CSS, MaterializeCSS, Node.js, Express y MongoDB, integrando tanto frontend como backend para construir una solución completa y funcional.",
        link: "https://crud-frontend-sooty.vercel.app/",
        code: "https://github.com/jeronimo24perez/crudFrontend",
        image: crud
    },{
        id: 4,
        name: "E-commerce Gorras",
        tech: ["devicon-react-original colored  ", "devicon-css3-plain colored", "devicon-javascript-plain colored", "devicon-tailwindcss-plain colored",  "devicon-django-plain colored ","devicon-python-plain-wordmark", "devicon-postgresql-plain colored"],
        description: "En este proyecto desarrollé un E-commerce de gorras, enfocado en ofrecer una experiencia de compra moderna, dinámica y funcional.\n" +
            "\n" +
            "Para su desarrollo utilicé React, JavaScript y TailwindCSS en el frontend, junto con Python/ django, y postgresql en el backend, construyendo una aplicación completa con estructura escalable y orientada al usuario.",
        link: "https://gorras-app.vercel.app/",
        code: "https://github.com/jeronimo24perez/gorrasApp",
        image: gorrasApp
    }
]

const backend: Project[] = [
    {
        id: 7,
        name: "Backend E-commerce Gorras",
        tech: ["devicon-django-plain colored ","devicon-python-plain-wordmark", "devicon-postgresql-plain colored"],
        description: "Servidor backend desarrollado para el E-commerce de gorras, encargado de gestionar productos,carrito,usuarios, lógica de negocio entre otras cosas.\n" +
            "Construido con Django, y Postgresql, permite una administración eficiente de la información, con una estructura escalable y orientada a un funcionamiento sólido del sistema.",
        code: "https://github.com/jeronimo24perez/gorras-backend-django",
        link: 'https://gorras-backend-django-1ui3.vercel.app/',
        image: backendGorras
    },
    {
        id: 5,
        name: "Backend del clon de X",
        tech: ["devicon-python-plain-wordmark  ", "devicon-fastapi-plain colored ","devicon-mongodb-plain colored"],
        description: "En este proyecto desarrollé la API del clon de X, encargada de gestionar toda la lógica del sistema y la comunicación con el frontend.\n" +
            "Para su desarrollo utilicé Python con FastAPI y MongoDB como base de datos, implementando funcionalidades como autenticación de usuarios, publicaciones, likes, seguidores y manejo de datos de forma eficiente y escalable.",
        code: "https://github.com/jeronimo24perez/x-backend",
        image: backendX
    },
    {
        id: 6,
        name: "Backend Aplicacion To Do",
        tech: ["devicon-nodejs-plain colored ", "devicon-express-original", "devicon-mongodb-plain colored"],
        description: "API REST desarrollada con Node.js, Express y MongoDB para la gestión de tareas, implementando operaciones CRUD completas (Create, Read, Update, Delete).\n" +
            "\n" +
            "Permite crear, consultar, actualizar y eliminar tareas de forma eficiente, siguiendo una estructura backend organizada, escalable y orientada a buenas prácticas de desarrollo.",
        code: "https://github.com/jeronimo24perez/crudBackend",
        image: backendCrud
    }

]

---

{

    projects.map((project) =>(
    <div class="project-card glass">
        <Image src={project.image } alt={project.name} class="project-img" />
        <div class="card-body">
            <h3>{project.name}</h3>
            <p>{project.description}</p> <br/>

            <div class="techs">
                {project.tech.map((tech) => (
                        <i class={tech}></i>

                ))}
            </div> <br/>
            <div class="card-footer">
                <a href={project.link} target="_blank" class="button card-button" rel="noopener noreferrer">
                    Ver demo
                </a>

                <a href={project.code} target="_blank" class="button card-button" rel="noopener noreferrer">
                    Ver codigo
                </a>
            </div>


        </div>

    </div>
        ))}

<div class="separator-container">
    <h2 >Proyectos Backend</h2>

</div>
{backend.map((project) =>(
    <div class="project-card glass">
        <Image src={project.image } alt={project.name} class="project-img" />
        <div class="card-body">
            <h3>{project.name}</h3>
            <p>{project.description}</p> <br/>

            <div class="techs">
                {project.tech.map((tech) => (
                        <i class={tech}></i>

                ))}
            </div> <br/>
            <div class="card-footer">
                <a href={project.link? project.link: project.code} target="_blank"  class="button card-button" rel="noopener noreferrer">
                    Ver demo
                </a>
                <a href={project.code} target="_blank"  class="button card-button" rel="noopener noreferrer">
                    Ver codigo
                </a>

            </div>
        </div>
    </div>
            ))
    }
